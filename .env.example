# ═══════════════════════════════════════════════════════
#  DocMind — Environment Variables Template
#  Copy this file to .env and fill in your actual keys
# ═══════════════════════════════════════════════════════

# ─── 1. Application Configuration ───
APP_ENV=development                       # development | production
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── 2. Relational Database ───
# Primary: PostgreSQL (e.g. Supabase connection string).
# Auto-fallback: If unreachable or left as SQLite, system automatically uses sqlite:///./docmind.db
DATABASE_URL=sqlite:///./docmind.db
# Example Supabase: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── 3. LLM Reasoning Engine ───
GEMINI_API_KEY=your_google_gemini_api_key_here    # Primary LLM API Key (required for Gemini)
GROQ_API_KEY=your_groq_api_key_here              # Tertiary Fallback LLM (optional, Llama 3.3 70B)
LLM_MODEL=gemini-3.5-flash                       # Primary: gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-2.5-pro                # Secondary: gemini-2.5-pro
LLM_TEMPERATURE=0.2
MAX_CONTEXT_TOKENS=8192

# ─── 4. Embeddings Engine ───
# Provider fallback chain: "huggingface" -> "gemini" -> "local" (PyTorch SIMD)
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_API_TOKEN=your_huggingface_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── 5. Vector Database ───
VECTOR_STORE=chroma                              # "pinecone" for cloud prod | "chroma" for local dev NumPy store
CHROMA_PERSIST_DIR=./chroma_store
PINECONE_API_KEY=your_pinecone_api_key_here      # Required if VECTOR_STORE=pinecone
PINECONE_INDEX=docmind                           # Index name (dimension: 384, metric: cosine)

# ─── 6. File Storage ───
STORAGE_BACKEND=local                            # "local" | "r2"
LOCAL_UPLOAD_DIR=./uploads
# Optional Cloudflare R2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=docmind-uploads

# ─── 7. Authentication (JWT Security) ───
JWT_SECRET_KEY=generate_a_secure_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080                # 7 days
REFRESH_TOKEN_WINDOW_MINUTES=14400               # 10 days

# ─── 8. RAG Chunking & Retrieval Parameters ───
CHUNK_SIZE=900                                   # 900 chars (~220 tokens, calibrated for MiniLM-L6-v2)
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=8

# ─── 9. Upload Limits & Formats ───
MAX_FILE_SIZE_MB=200
ALLOWED_EXTENSIONS=pdf,docx,xlsx,xls,csv,pptx,txt,md,json,png,jpg,jpeg,webp,gif,bmp,tiff

# ─── 10. CORS Security ───
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
